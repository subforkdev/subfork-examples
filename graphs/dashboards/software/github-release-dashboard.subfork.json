{
  "format": "subfork.graph/1",
  "definition": {
    "version": "0.1.0",
    "name": "GitHub Release Dashboard",
    "description": "Fetches one bounded page of public GitHub releases, normalizes release records, and binds them to linked dashboard panels. Read-only and keyless with unauthenticated rate limits.",
    "nodes": [
      {
        "node_instance_id": "url",
        "node_id": "n_url_input",
        "node_version": "1.0.0",
        "title": "GitHub releases URL",
        "params": {
          "url": "https://api.github.com/repos/cli/cli/releases"
        }
      },
      {
        "node_instance_id": "fetch",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Fetch public releases",
        "params": {
          "method": "GET",
          "query": {
            "per_page": 30,
            "page": 1
          },
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2026-03-10"
          },
          "timeout_seconds": 20,
          "max_response_bytes": 1000000
        },
        "exposed_inputs": [
          "url"
        ],
        "inputs_visibility_configured": true,
        "exposed_outputs": [
          "json",
          "status"
        ],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "limit",
        "node_id": "n_limit",
        "node_version": "1.0.0",
        "title": "At most 30 releases",
        "params": {
          "count": 30
        }
      },
      {
        "node_instance_id": "normalize",
        "node_id": "n_map_fields",
        "node_version": "1.0.0",
        "title": "Normalize release records",
        "params": {
          "mapping": {
            "id": "id",
            "tag": "tag_name",
            "title": "name",
            "author": "author.login",
            "published_at": "published_at",
            "created_at": "created_at",
            "url": "html_url",
            "prerelease": "prerelease",
            "draft": "draft",
            "body": "body"
          }
        }
      },
      {
        "node_instance_id": "sort",
        "node_id": "n_sort_rows",
        "node_version": "1.0.0",
        "title": "Newest published first",
        "params": {
          "field": "published_at",
          "direction": "desc"
        }
      },
      {
        "node_instance_id": "response",
        "node_id": "n_json_response",
        "node_version": "1.0.0",
        "title": "Release JSON response"
      }
    ],
    "edges": [
      {
        "source_node_id": "url",
        "source_output": "url",
        "target_node_id": "fetch",
        "target_input": "url"
      },
      {
        "source_node_id": "fetch",
        "source_output": "json",
        "target_node_id": "limit",
        "target_input": "items"
      },
      {
        "source_node_id": "limit",
        "source_output": "items",
        "target_node_id": "normalize",
        "target_input": "value"
      },
      {
        "source_node_id": "normalize",
        "source_output": "items",
        "target_node_id": "sort",
        "target_input": "items"
      },
      {
        "source_node_id": "sort",
        "source_output": "items",
        "target_node_id": "response",
        "target_input": "value"
      }
    ],
    "graph_outputs": {
      "releases": {
        "node_instance_id": "sort",
        "output_name": "items"
      },
      "status": {
        "node_instance_id": "fetch",
        "output_name": "status"
      },
      "response": {
        "node_instance_id": "response",
        "output_name": "response"
      }
    },
    "metadata": {
      "category": "dashboards",
      "template": {
        "status": "provider-backed-example",
        "summary": "Bounded public GitHub release records driving linked native panels.",
