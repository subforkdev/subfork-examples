{
  "format": "subfork.graph/1",
  "definition": {
    "version": "0.1.0",
    "name": "Pulse Orbit",
    "description": "Analyzes the first 30 seconds of an uploaded track and turns its energy and downbeats into reusable 3D transform keyframes for a procedural orbit sculpture.",
    "nodes": [
      {
        "node_instance_id": "audio_file",
        "node_id": "n_asset",
        "node_version": "1.0.0",
        "title": "Upload music",
        "params": {
          "artifact_id": ""
        },
        "exposed_outputs": [
          "artifact",
          "filename",
          "media_type",
          "size_bytes"
        ],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "analysis",
        "node_id": "n_music_analysis",
        "node_version": "1.0.0",
        "title": "Analyze first 30 seconds",
        "params": {
          "start_seconds": 0,
          "duration_seconds": 30,
          "max_bytes": 50000000,
          "timeout_seconds": 60
        }
      },
      {
        "node_instance_id": "energy",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Select energy envelope",
        "params": {
          "path": "energy"
        }
      },
      {
        "node_instance_id": "lift",
        "node_id": "n_compute_field",
        "node_version": "1.0.0",
        "title": "Energy to vertical lift",
        "params": {
          "operation": "multiply_add",
          "operand": 0.7,
          "offset": -0.35,
          "minimum": 0,
          "maximum": 1,
          "source_field": "value",
          "destination_field": "lift",
          "overwrite": false
        }
      },
      {
        "node_instance_id": "pulse_scale",
        "node_id": "n_compute_field",
        "node_version": "1.0.0",
        "title": "Energy to pulse scale",
        "params": {
          "operation": "multiply_add",
          "operand": 0.65,
          "offset": 1,
          "minimum": 0,
          "maximum": 1,
          "source_field": "value",
          "destination_field": "pulse_scale",
          "overwrite": false
        }
      },
      {
        "node_instance_id": "pulse_rows",
        "node_id": "n_map_fields",
        "node_version": "1.0.0",
        "title": "Shape pulse TRS rows",
        "params": {
          "mapping": {
            "time_seconds": "time_seconds",
            "position.x": 0,
            "position.y": "lift",
            "position.z": 0,
            "scale.x": "pulse_scale",
            "scale.y": "pulse_scale",
            "scale.z": "pulse_scale"
          }
        }
      },
      {
        "node_instance_id": "pulse_keyframes",
        "node_id": "n_scene_keyframes",
        "node_version": "1.0.0",
        "title": "Pulse keyframes",
        "params": {
          "interpolation": "linear"
        }
      },
      {
        "node_instance_id": "downbeats",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Select downbeats",
        "params": {
          "path": "downbeats"
        }
      },
      {
        "node_instance_id": "yaw",
        "node_id": "n_compute_field",
        "node_version": "1.0.0",
        "title": "Downbeats to yaw",
        "params": {
          "operation": "multiply",
          "operand": 0.1,
          "offset": 0,
          "minimum": 0,
          "maximum": 1,
          "source_field": "beat_index",
          "destination_field": "yaw",
          "overwrite": false
        }
      },
      {
        "node_instance_id": "turn_rows",
        "node_id": "n_map_fields",
        "node_version": "1.0.0",
        "title": "Shape turn TRS rows",
        "params": {
          "mapping": {
            "time_seconds": "time_seconds",
            "rotation.x": 0,
            "rotation.y": "yaw",
            "rotation.z": 0
          }
        }
      },
      {
        "node_instance_id": "turn_keyframes",
        "node_id": "n_scene_keyframes",
        "node_version": "1.0.0",
        "title": "Downbeat turn keyframes",
        "params": {
          "interpolation": "step"
        }
      },
      {
        "node_instance_id": "core_geometry",
        "node_id": "n_scene_geometry",
        "node_version": "1.0.0",
        "title": "Sphere geometry",
