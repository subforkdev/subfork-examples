        "output_name": "status"
      }
    },
    "metadata": {
      "template": {
        "category": "ai",
        "status": "provider-backed-probe",
        "summary": "Read a short pasted text aloud with editable voice and delivery instructions; no text rewriting. Paid provider calls; AI-generated voice.",
