        "target_input": "value"
      },
      {
        "source_node_id": "delivery",
        "source_output": "text",
        "target_node_id": "delivery_check",
        "target_input": "text"
      },
      {
        "source_node_id": "delivery_check",
        "source_output": "matches",
        "target_node_id": "delivery_check_value",
        "target_input": "value"
      },
      {
        "source_node_id": "voice",
        "source_output": "text",
        "target_node_id": "voice_check",
        "target_input": "text"
      },
      {
        "source_node_id": "voice_check",
        "source_output": "matches",
        "target_node_id": "voice_check_value",
        "target_input": "value"
      },
      {
        "source_node_id": "script_check_value",
        "source_output": "value",
        "target_node_id": "speech_body",
        "target_input": "script"
      },
      {
        "source_node_id": "delivery_check_value",
        "source_output": "value",
        "target_node_id": "speech_body",
        "target_input": "delivery"
      },
      {
        "source_node_id": "voice_check_value",
        "source_output": "value",
        "target_node_id": "speech_body",
        "target_input": "voice"
      },
      {
        "source_node_id": "speech_body",
        "source_output": "value",
        "target_node_id": "speech_request",
        "target_input": "body"
      },
      {
        "source_node_id": "speech_request",
        "source_output": "media",
        "target_node_id": "response",
        "target_input": "media"
      }
    ],
    "graph_outputs": {
      "audio": {
        "node_instance_id": "speech_request",
        "output_name": "media"
      },
      "transcript": {
        "node_instance_id": "script_check_value",
