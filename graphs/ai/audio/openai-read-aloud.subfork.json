{
  "format": "subfork.graph/1",
  "definition": {
    "version": "0.1.0",
    "name": "OpenAI Read Aloud",
    "description": "Read a short pasted text aloud with editable voice and delivery instructions; no text rewriting. Paid provider calls; AI-generated voice.",
    "nodes": [
      {
        "node_instance_id": "script",
        "node_id": "n_text_value",
        "node_version": "1.0.0",
        "title": "Text to read (maximum 3500 characters)",
        "params": {
          "text": "At the edge of the village stood a small observatory. Every evening, its keeper opened the roof and pointed the telescope toward the first bright star. Tonight, a visitor arrived with a notebook full of questions. They began with the simplest one: what can we learn by looking up?"
        }
      },
      {
        "node_instance_id": "script_check",
        "node_id": "n_text_match",
        "node_version": "1.0.0",
        "title": "Require nonempty script up to 3500 characters",
        "params": {
          "pattern": "\\A(?=[\\s\\S]*\\S)[\\s\\S]{1,3500}\\Z",
          "flags": "",
          "operation": "extract"
        }
      },
      {
        "node_instance_id": "script_check_value",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Require nonempty script up to 3500 characters value",
        "params": {
          "path": "0"
        }
      },
      {
        "node_instance_id": "delivery",
        "node_id": "n_text_value",
        "node_version": "1.0.0",
        "title": "Voice direction",
        "params": {
          "text": "Narrate warmly and clearly, like an audiobook. Use an unhurried pace, natural sentence pauses, and restrained expression."
        }
      },
      {
        "node_instance_id": "voice",
        "node_id": "n_text_value",
        "node_version": "1.0.0",
        "title": "Voice (marin or cedar recommended)",
        "params": {
          "text": "marin"
        }
      },
      {
        "node_instance_id": "delivery_check",
        "node_id": "n_text_match",
        "node_version": "1.0.0",
        "title": "Require voice direction up to 1000 characters",
        "params": {
          "pattern": "\\A(?=[\\s\\S]*\\S)[\\s\\S]{1,1000}\\Z",
          "flags": "",
          "operation": "extract"
        }
      },
      {
        "node_instance_id": "delivery_check_value",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Require voice direction up to 1000 characters value",
        "params": {
          "path": "0"
        }
      },
      {
        "node_instance_id": "voice_check",
        "node_id": "n_text_match",
        "node_version": "1.0.0",
        "title": "Require supported built-in voice",
        "params": {
          "pattern": "\\A(?:alloy|ash|ballad|coral|echo|fable|nova|onyx|sage|shimmer|verse|marin|cedar)\\Z",
          "flags": "",
          "operation": "extract"
        }
      },
      {
        "node_instance_id": "voice_check_value",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Require supported built-in voice value",
        "params": {
          "path": "0"
        }
      },
      {
        "node_instance_id": "speech_body",
        "node_id": "n_json_template",
        "node_version": "1.0.0",
        "title": "Speech request body",
        "params": {
          "template": {
            "model": "gpt-4o-mini-tts",
            "voice": "{{ inputs.voice }}",
            "input": "{{ inputs.script }}",
            "instructions": "{{ inputs.delivery }}",
            "response_format": "mp3"
          }
        },
        "custom_inputs": {
          "script": "str",
          "delivery": "str",
          "voice": "str"
        },
        "exposed_inputs": [
          "script",
          "delivery",
          "voice"
        ],
        "inputs_visibility_configured": true
      },
      {
        "node_instance_id": "speech_request",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Generate speech",
        "params": {
          "url": "https://api.openai.com/v1/audio/speech",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{ secrets.OPENAI_API_KEY }}",
            "Content-Type": "application/json",
            "Accept": "audio/mpeg"
          },
          "timeout_seconds": 120,
          "max_response_bytes": 10000000
        },
        "exposed_outputs": [
          "media",
          "status",
          "json"
        ],
        "outputs_visibility_configured": true,
        "exposed_inputs": [
          "body"
        ],
        "inputs_visibility_configured": true
      },
      {
        "node_instance_id": "response",
        "node_id": "n_media_response",
        "node_version": "1.0.0",
        "title": "Audio response",
        "params": {
          "content_type": "audio/mpeg",
          "filename": "openai-read-aloud.mp3"
        }
      }
    ],
    "edges": [
      {
        "source_node_id": "script",
        "source_output": "text",
        "target_node_id": "script_check",
        "target_input": "text"
      },
      {
        "source_node_id": "script_check",
