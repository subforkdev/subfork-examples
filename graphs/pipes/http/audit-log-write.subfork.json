  "definition": {
    "version": "0.1.0",
    "name": "Audit Log Write",
    "description": "Audit record append over HTTP. Builds one record from actor, action, subject_id, payload, and an optional occurred_at, POSTs it to sink_url, and returns the record id, the sink response, and the HTTP status. This is an externally visible write, and a retry can append a duplicate record. There is no clock node, so the caller passes occurred_at or the sink stamps it. Credentials arrive only through the headers input. This graph references no secrets.",
    "nodes": [
      {
        "node_instance_id": "rec",
        "node_id": "n_json_template",
        "node_version": "1.0.0",
        "title": "Audit record",
        "params": {
          "template": {
            "actor": "{{ inputs.actor }}",
            "action": "{{ inputs.action }}",
            "subject_id": "{{ inputs.subject_id }}",
            "payload": "{{ inputs.payload }}",
            "occurred_at?": "{{ inputs.occurred_at }}"
          }
        },
        "custom_inputs": {
          "actor": "str",
          "action": "str",
          "subject_id": "str",
          "payload": "json",
          "occurred_at": "str"
