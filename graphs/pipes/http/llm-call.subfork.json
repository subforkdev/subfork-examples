        "node_instance_id": "body",
        "node_id": "n_json_template",
        "node_version": "1.0.0",
        "title": "Chat request body",
        "params": {
          "template": {
            "model": "{{ inputs.model }}",
            "messages": [
              {
                "role": "system",
                "content": "{{ inputs.system }}"
              },
              {
                "role": "user",
                "content": "{{ inputs.prompt }}"
              }
            ]
          }
        },
        "custom_inputs": {
          "prompt": "str",
          "system": "str",
          "model": "str"
        },
