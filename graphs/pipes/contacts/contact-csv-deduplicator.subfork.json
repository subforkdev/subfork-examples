          }
        },
        "recommended_panels": [
          {
            "kind": "table",
            "binding": {
              "nodeInstanceId": "limit",
              "outputName": "items"
            }
          },
          {
            "kind": "json",
            "binding": {
              "nodeInstanceId": "response",
              "outputName": "response"
            }
          }
        ]
      }
    }
  },
  "tags": [
