  "definition": {
    "version": "0.1.0",
    "name": "US Public Holiday Calendar",
    "description": "Fetches 2026 U.S. holiday data, keeps national entries, and returns a bounded iCalendar response plus table-ready rows.",
    "nodes": [
      {
        "node_instance_id": "request",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Fetch U.S. holidays",
        "params": {
          "url": "https://date.nager.at/api/v3/publicholidays/2026/US",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          },
          "timeout_seconds": 20,
          "max_response_bytes": 300000
        },
        "exposed_inputs": [],
        "inputs_visibility_configured": true,
        "exposed_outputs": [
          "json",
          "status"
        ],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "national",
        "node_id": "n_filter_rows",
        "node_version": "1.0.0",
        "title": "National holidays only",
        "params": {
          "field": "global",
          "operation": "equals",
          "equals": true
        }
      },
      {
        "node_instance_id": "project",
        "node_id": "n_map_fields",
        "node_version": "1.0.0",
        "title": "Normalize calendar events",
        "params": {
          "mapping": {
            "title": "name",
            "date": "date",
            "description": "localName",
            "country": "countryCode",
            "type": "types.0",
            "fixed_date": "fixed"
          }
        }
      },
      {
        "node_instance_id": "sort",
        "node_id": "n_sort_rows",
        "node_version": "1.0.0",
        "title": "Chronological holidays",
        "params": {
          "field": "date",
          "direction": "asc"
        }
      },
      {
        "node_instance_id": "limit",
        "node_id": "n_limit",
        "node_version": "1.0.0",
        "title": "At most 25 holidays",
        "params": {
          "count": 25
        }
      },
      {
        "node_instance_id": "response",
        "node_id": "n_ics_response",
        "node_version": "1.0.0",
        "title": "Holiday calendar response",
        "params": {
          "name": "U.S. Public Holidays 2026"
        }
      }
    ],
