{
  "format": "subfork.graph/1",
  "thumbnail": "data:image/jpeg;base64,",
  "definition": {
    "version": "0.1.0",
    "name": "Natural Event Keyword Router",
    "description": "Checks a bounded NASA EONET snapshot for a wildfire category and emits one of two routing decisions.",
    "nodes": [
      {
        "node_instance_id": "request",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Fetch recent open events",
        "params": {
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events",
          "method": "GET",
          "query": {
            "status": "open",
            "days": 30,
            "limit": 10
          },
          "headers": {
            "Accept": "application/json"
          },
          "timeout_seconds": 20,
          "max_response_bytes": 500000
        },
        "exposed_inputs": [],
        "inputs_visibility_configured": true,
        "exposed_outputs": [
          "body",
          "status"
        ],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "match",
        "node_id": "n_text_match",
        "node_version": "1.0.0",
        "title": "Contains wildfire category",
        "params": {
          "pattern": "\"id\"\\s*:\\s*\"wildfires\"",
          "flags": "i",
          "operation": "test"
        }
      },
      {
        "node_instance_id": "route",
        "node_id": "n_conditional",
        "node_version": "1.0.0",
        "title": "Choose next route",
        "params": {
          "when_true": {
            "route": "review-wildfire-events",
            "matched": true,
            "message": "The current bounded EONET snapshot contains a wildfire category."
          },
          "when_false": {
            "route": "no-wildfire-match",
            "matched": false,
            "message": "The current bounded EONET snapshot contains no wildfire category."
          }
        }
      },
      {
        "node_instance_id": "response",
        "node_id": "n_json_response",
        "node_version": "1.0.0",
        "title": "Routing decision response"
      }
    ],
    "edges": [
      {
        "source_node_id": "request",
        "source_output": "body",
        "target_node_id": "match",
        "target_input": "text"
      },
      {
        "source_node_id": "match",
        "source_output": "matched",
        "target_node_id": "route",
        "target_input": "condition"
      },
      {
        "source_node_id": "route",
        "source_output": "value",
        "target_node_id": "response",
        "target_input": "value"
      }
    ],
    "graph_outputs": {
      "matched": {
        "node_instance_id": "match",
        "output_name": "matched"
      },
      "decision": {
        "node_instance_id": "route",
        "output_name": "value"
      },
      "status": {
        "node_instance_id": "request",
        "output_name": "status"
      },
      "response": {
        "node_instance_id": "response",
        "output_name": "response"
      }
    },
    "metadata": {
      "template": {
        "category": "events",
        "status": "event-decision-probe",
        "composite_interface": {
          "inputs": {},
          "outputs": {
            "matched": {
              "type": "bool",
              "node_instance_id": "match",
              "output_name": "matched"
            },
            "decision": {
              "type": "json",
              "node_instance_id": "route",
              "output_name": "value"
            },
            "status": {
              "type": "int",
              "node_instance_id": "request",
              "output_name": "status"
            }
          }
        },
        "requires": {
          "nodes": [
            "n_fetch_url",
            "n_text_match",
            "n_conditional",
            "n_json_response"
          ],
          "panels": [
            "json",
            "logs"
          ],
          "capabilities": [
            "public-http"
          ],
          "secrets": []
        }
      },
      "canvas": {
        "positions": {
          "request": {
            "x": 100,
            "y": 180
          },
          "match": {
            "x": 410,
            "y": 180
          },
          "route": {
            "x": 720,
            "y": 180
          },
          "response": {
            "x": 1030,
            "y": 180
          }
        },
        "recommended_panels": [
          {
            "kind": "json",
            "binding": {
              "nodeInstanceId": "response",
              "outputName": "response"
            }
          }
        ]
      }
    }
  },
  "tags": [
    "events",
    "automation"
  ]
}
