      },
      {
        "node_instance_id": "page",
        "node_id": "n_html_template",
        "node_version": "1.0.0",
        "title": "Render printable labels",
        "params": {
          "template": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Printable Label Sheet</title>\n<style>\n@page{size:letter;margin:.5in}*{box-sizing:border-box}body{margin:0;background:#ecece8;color:#171915;font:14px/1.35 system-ui,sans-serif}main{max-width:8.5in;margin:24px auto;background:white;padding:.5in;box-shadow:0 5px 24px #0002}header{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #777;padding-bottom:12px;margin-bottom:18px}h1{font:36px/1 Georgia,serif;margin:0}.meta{font:12px monospace;color:#555}.sheet{display:grid;grid-template-columns:repeat(3,1fr);gap:.125in .15in}.label{height:.95in;border:1px dashed #aaa;border-radius:4px;padding:.12in .16in;overflow:hidden;break-inside:avoid}.name{font-weight:700}.line{min-height:1.2em}#error{border:1px solid #a33;padding:14px;color:#811}@media print{body{background:#fff}main{margin:0;max-width:none;padding:0;box-shadow:none}header{display:none}.sheet{gap:.125in .15in}.label{border-color:#ddd}}\n</style>\n</head>\n<body>\n<main><header><div><div class=\"meta\">SUBFORK / PRINT PREVIEW</div><h1>Mailing Labels</h1></div><div class=\"meta\"><span id=\"count\">0</span> labels<br>Letter / 3 columns</div></header><p id=\"error\" role=\"alert\" hidden></p><section id=\"sheet\" class=\"sheet\" aria-label=\"Mailing labels\"></section></main>\n<script id=\"rows\" type=\"application/json\">{{ inputs.rows_json }}</script>\n<script>\n\"use strict\";\nconst text=(value)=>String(value??\"\").trim();\ntry{\n const rows=JSON.parse(document.getElementById(\"rows\").textContent);if(!Array.isArray(rows)||rows.length>60)throw new Error(\"Expected at most 60 address rows.\");\n const root=document.getElementById(\"sheet\");\n rows.forEach((row)=>{\n  const label=document.createElement(\"article\");label.className=\"label\";\n  const locality=[text(row.city),text(row.region),text(row.postal_code)].filter(Boolean).join(\" \"),lines=[text(row.name),text(row.address1),text(row.address2),locality,text(row.country)].filter(Boolean);\n  lines.forEach((value,index)=>{const line=document.createElement(\"div\");line.className=index===0?\"line name\":\"line\";line.textContent=value;label.append(line)});root.append(label);\n });document.getElementById(\"count\").textContent=String(rows.length);\n}catch(error){const el=document.getElementById(\"error\");el.hidden=false;el.textContent=error instanceof Error?error.message:\"Unable to render labels.\"}\n</script>\n</body>\n</html>\n"
        },
