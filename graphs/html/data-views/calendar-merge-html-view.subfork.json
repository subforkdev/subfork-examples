        "node_instance_id": "template",
        "node_id": "n_html_template",
        "node_version": "1.0.0",
        "title": "Agenda HTML",
        "params": {
          "template": "<!doctype html>\n<html>\n<head><meta charset=\"utf-8\"><title>Merged Calendar</title><script src=\"https://cdn.jsdelivr.net/npm/fullcalendar@6.1.21/index.global.min.js\"></script><style>body{font-family:ui-sans-serif,system-ui;margin:0;background:#fffaf0;color:#15211d}main{min-height:100vh;padding:1.25rem}.shell{display:grid;grid-template-rows:auto minmax(0,1fr);gap:1rem;min-height:calc(100vh - 2.5rem)}header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;border-bottom:1px solid #d8d0b8;padding-bottom:.8rem}h1{margin:0;font-size:1.5rem}.meta{color:#5f6e56;font-size:.85rem}#calendar{min-height:34rem;background:#fff;border:1px solid #d8d0b8;padding:.75rem}.fc{font-size:.86rem}.fc .fc-toolbar-title{font-size:1.1rem}.fc-event{border-color:#0f5d47;background:#0f5d47}.fallback{border:1px solid #d8d0b8;background:#fff;padding:1rem}</style></head>\n<body><main><section class=\"shell\"><header><div><h1>Merged Calendar</h1><div id=\"summary\" class=\"meta\">Loading merged ICS events...</div></div></header><div id=\"calendar\"></div></section><script type=\"application/json\" id=\"events-json\">{{ inputs.events_json }}</script><script>function parseEvents(){try{return JSON.parse(document.getElementById('events-json').textContent)||[]}catch(error){return[]}}function eventDate(value){if(!value)return undefined;return String(value)}function toCalendarEvent(event,index){const start=eventDate(event.start||event.date||event.dtstart);const end=eventDate(event.end||event.dtend);return {id:String(event.uid||event.id||index),title:String(event.title||event.summary||'Untitled event'),start:start,end:end,allDay:start?!start.includes('T'):true,extendedProps:{description:event.description||'',source:event.source||''}}}const rawEvents=parseEvents();const calendarEvents=rawEvents.map(toCalendarEvent).filter(event=>event.start).slice(0,200);document.getElementById('summary').textContent=`${calendarEvents.length} merged events`;document.addEventListener('DOMContentLoaded',()=>{const calendarEl=document.getElementById('calendar');if(!window.FullCalendar){calendarEl.className='fallback';calendarEl.textContent='FullCalendar could not be loaded from the CDN.';return}const calendar=new FullCalendar.Calendar(calendarEl,{initialView:'dayGridMonth',height:'auto',events:calendarEvents,headerToolbar:{left:'prev,next today',center:'title',right:'dayGridMonth,timeGridWeek,listMonth'},eventDidMount(info){const description=info.event.extendedProps.description;if(description)info.el.title=description}});calendar.render()});</script></main></body>\n</html>"
        },
