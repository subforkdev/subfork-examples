        "output_name": "response"
      },
      "data_response": {
        "node_instance_id": "data_response",
        "output_name": "response"
      }
    },
    "metadata": {
      "template": {
        "category": "games",
        "status": "prototype",
        "summary": "Uploaded CSV rows become a deterministic local Canvas game.",
        "requires": {
