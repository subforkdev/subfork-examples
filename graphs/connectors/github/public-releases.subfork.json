{
  "format": "subfork.graph/1",
  "thumbnail": "data:image/jpeg;base64,",
  "definition": {
    "version": "0.1.0",
    "name": "Public GitHub Releases",
    "description": "Fetches a bounded page of published releases for a public GitHub repository and exposes the rows as JSON.",
    "nodes": [
      {
        "node_instance_id": "repository_url",
        "node_id": "n_url_input",
        "node_version": "1.0.0",
        "title": "GitHub releases URL",
        "params": {
          "url": "https://api.github.com/repos/cli/cli/releases"
        }
      },
      {
        "node_instance_id": "request",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Fetch public releases",
        "params": {
          "method": "GET",
          "query": {
            "per_page": 10,
            "page": 1
          },
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2026-03-10"
          },
          "timeout_seconds": 20,
          "max_response_bytes": 500000
        },
        "exposed_inputs": [
          "url"
        ],
        "inputs_visibility_configured": true,
        "exposed_outputs": [
          "json",
          "status"
        ],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "limit",
        "node_id": "n_limit",
        "node_version": "1.0.0",
        "title": "At most ten releases",
        "params": {
          "count": 10
        }
      },
      {
        "node_instance_id": "response",
        "node_id": "n_json_response",
        "node_version": "1.0.0",
        "title": "Release JSON response"
      }
    ],
    "edges": [
      {
        "source_node_id": "repository_url",
        "source_output": "url",
        "target_node_id": "request",
        "target_input": "url"
      },
      {
        "source_node_id": "request",
        "source_output": "json",
        "target_node_id": "limit",
        "target_input": "items"
      },
      {
        "source_node_id": "limit",
        "source_output": "items",
        "target_node_id": "response",
        "target_input": "value"
      }
    ],
    "graph_outputs": {
      "releases": {
        "node_instance_id": "limit",
        "output_name": "items"
      },
      "status": {
        "node_instance_id": "request",
        "output_name": "status"
      },
      "response": {
        "node_instance_id": "response",
        "output_name": "response"
      }
    },
    "metadata": {
      "template": {
        "category": "connectors",
        "status": "provider-backed-probe",
        "composite_interface": {
          "inputs": {
            "url": {
              "type": "url",
              "default_node": "repository_url",
              "default_param": "url"
            }
          },
          "outputs": {
            "releases": {
              "type": "json",
              "node_instance_id": "limit",
              "output_name": "items"
            },
            "status": {
              "type": "int",
              "node_instance_id": "request",
              "output_name": "status"
            }
          }
        },
        "requires": {
          "nodes": [
            "n_url_input",
            "n_fetch_url",
            "n_limit",
            "n_json_response"
          ],
          "panels": [
            "table",
            "json",
            "logs"
          ],
          "capabilities": [
            "public-http"
          ],
          "secrets": []
        }
      },
      "canvas": {
        "positions": {
          "repository_url": {
            "x": 80,
            "y": 180
          },
          "request": {
            "x": 360,
            "y": 180
          },
          "limit": {
            "x": 640,
            "y": 180
          },
          "response": {
            "x": 900,
            "y": 180
          }
        },
        "recommended_panels": [
          {
            "kind": "table",
            "binding": {
              "nodeInstanceId": "limit",
              "outputName": "items"
            }
          },
          {
            "kind": "json",
            "binding": {
              "nodeInstanceId": "response",
              "outputName": "response"
            }
          }
        ]
      }
    }
  },
  "tags": [
    "connectors",
    "github"
  ]
}
