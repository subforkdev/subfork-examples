{
  "format": "subfork.graph/1",
  "definition": {
    "version": "0.2.0",
    "name": "Airtable Record Browser",
    "description": "Reads at most 25 records from one Airtable table using a graph-scoped personal access token.",
    "nodes": [
      {
        "node_instance_id": "request",
        "node_id": "n_fetch_url",
        "node_version": "1.0.0",
        "title": "Fetch Airtable records",
        "params": {
          "url": "https://api.airtable.com/v0/{{ vars.AIRTABLE_BASE_ID }}/{{ vars.AIRTABLE_TABLE_ID }}",
          "method": "GET",
          "query": {"maxRecords": 25, "pageSize": 25},
          "headers": {
            "Authorization": "Bearer {{ secrets.AIRTABLE_ACCESS_TOKEN }}",
            "Accept": "application/json"
          },
          "timeout_seconds": 20,
          "max_response_bytes": 500000
        },
        "exposed_inputs": [],
        "inputs_visibility_configured": true,
        "exposed_outputs": ["json", "status"],
        "outputs_visibility_configured": true
      },
      {
        "node_instance_id": "records",
        "node_id": "n_json_path",
        "node_version": "1.0.0",
        "title": "Record rows",
        "params": {"path": "records"}
      },
      {
        "node_instance_id": "response",
        "node_id": "n_json_response",
        "node_version": "1.0.0",
        "title": "Record JSON response"
      }
    ],
    "edges": [
      {"source_node_id": "request", "source_output": "json", "target_node_id": "records", "target_input": "value"},
      {"source_node_id": "records", "source_output": "value", "target_node_id": "response", "target_input": "value"}
    ],
    "graph_outputs": {
      "records": {"node_instance_id": "records", "output_name": "value"},
      "status": {"node_instance_id": "request", "output_name": "status"},
      "response": {"node_instance_id": "response", "output_name": "response"}
    },
    "metadata": {
      "template": {
        "category": "connectors",
        "status": "provider-backed-probe",
        "composite_interface": {
          "inputs": {},
          "outputs": {
            "records": {"type": "json", "node_instance_id": "records", "output_name": "value"},
            "status": {"type": "int", "node_instance_id": "request", "output_name": "status"}
          }
        },
        "requires": {
          "nodes": ["n_fetch_url", "n_json_path", "n_json_response"],
          "panels": ["table", "json", "logs"],
          "capabilities": ["public-http"],
          "secrets": ["AIRTABLE_ACCESS_TOKEN"],
          "variables": ["AIRTABLE_BASE_ID", "AIRTABLE_TABLE_ID"]
        }
      },
      "canvas": {
        "positions": {
          "request": {"x": 160, "y": 180},
          "records": {"x": 480, "y": 180},
          "response": {"x": 800, "y": 180}
        },
        "recommended_panels": [
          {"kind": "table", "binding": {"nodeInstanceId": "records", "outputName": "value"}},
          {"kind": "json", "binding": {"nodeInstanceId": "response", "outputName": "response"}}
        ]
      }
    }
  }
}
