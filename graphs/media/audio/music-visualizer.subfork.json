  "definition": {
    "version": "0.1.0",
    "name": "Music Visualizer",
    "description": "Uploads bounded audio, probes it on a media worker, and renders six responsive browser-side Web Audio visualizations without external network calls.",
    "nodes": [
      {
        "node_instance_id": "audio_file",
        "node_id": "n_asset",
        "node_version": "1.0.0",
        "title": "Upload music",
        "params": {
          "artifact_id": ""
        },
        "exposed_outputs": [
          "artifact",
          "filename",
          "media_type",
          "size_bytes"
        ],
        "outputs_visibility_configured": true
      },
