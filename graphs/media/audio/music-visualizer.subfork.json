      {
        "node_instance_id": "page",
        "node_id": "n_html_template",
        "node_version": "1.0.0",
        "title": "Render beat visualizer",
        "params": {
          "template": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pulse Canvas</title><style>\n:root{color-scheme:dark;--ink:#f9f4ff;--panel:#080611cc;--line:#ffffff22}*{box-sizing:border-box}html,body,main{width:100%;height:100%;min-width:0;min-height:0;margin:0;overflow:hidden}body{background:#020208;color:var(--ink);font:12px/1.2 system-ui,sans-serif}main{position:relative;isolation:isolate}canvas{display:block;width:100%;height:100%;background:#020208}.chrome{position:absolute;z-index:2;left:clamp(8px,2vw,20px);right:clamp(8px,2vw,20px);bottom:clamp(8px,2vw,18px);display:flex;align-items:center;gap:8px;pointer-events:none}.title{margin-right:auto;color:#ffffff88;font:600 10px/1 ui-monospace,monospace;letter-spacing:.18em;text-transform:uppercase;text-shadow:0 1px 8px #000}.controls{display:flex;align-items:center;gap:5px;padding:5px;border:1px solid var(--line);border-radius:11px;background:var(--panel);box-shadow:0 8px 30px #0008;backdrop-filter:blur(10px);pointer-events:auto}button{height:30px;border:0;border-radius:7px;background:transparent;color:#d9d1e6;padding:0 9px;font:600 10px/1 system-ui,sans-serif;cursor:pointer}button:hover{background:#ffffff12;color:#fff}button[aria-pressed=true]{background:#ffffff1d;color:#fff;box-shadow:inset 0 0 0 1px #ffffff1c}.play{width:32px;padding:0;display:grid;place-items:center}.play svg{width:14px;height:14px;fill:currentColor}.modes{display:flex;gap:2px}.error{position:absolute;z-index:3;inset:auto 12px 58px;padding:9px 11px;border:1px solid #ff668855;border-radius:8px;background:#16060ddd;color:#ffc2cf;font:11px ui-monospace,monospace}.hidden{display:none}@media(max-width:620px){.chrome{align-items:flex-end}.title{writing-mode:vertical-rl;transform:rotate(180deg);margin:0 auto 2px 0}.controls{max-width:calc(100% - 28px);overflow-x:auto}.modes{min-width:max-content}button{padding-inline:7px}}\n</style></head><body><main><canvas id=\"view\" aria-label=\"Beat-reactive music visualization\"></canvas><div id=\"error\" class=\"error hidden\" role=\"alert\"></div><div class=\"chrome\"><span class=\"title\">Pulse Canvas</span><div class=\"controls\"><button class=\"play\" id=\"playback\" type=\"button\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path id=\"play-icon\" d=\"M8 5v14l11-7z\"/></svg></button><div class=\"modes\" id=\"modes\" aria-label=\"Visualization style\"><button data-mode=\"radial\">Radial</button><button data-mode=\"equalizer\">Blocks</button><button data-mode=\"spectrum\">Dots</button><button data-mode=\"ribbons\">Ribbons</button><button data-mode=\"wave\">Wave</button><button data-mode=\"console\">Console</button></div></div></div><audio id=\"audio\" preload=\"metadata\"></audio></main>\n<script id=\"page-data\" type=\"application/json\">{{ inputs.page_json }}</script><script>\n\"use strict\";const $=id=>document.getElementById(id),audio=$(\"audio\"),canvas=$(\"view\"),ctx=canvas.getContext(\"2d\"),playback=$(\"playback\"),playIcon=$(\"play-icon\"),errorBox=$(\"error\"),modeButtons=[...document.querySelectorAll(\"[data-mode]\")];const pageData=JSON.parse($(\"page-data\").textContent),config=pageData.visualizer||{};let ac,analyser,source,freq,wave,raf,w=1,h=1,dpr=1,pulse=0,level=0,bass=0,lastBeat=0,baseline=0,mode=({rings:\"radial\",bars:\"equalizer\"}[config.scene]||config.scene||\"radial\");const allowed=new Set(modeButtons.map(b=>b.dataset.mode));if(!allowed.has(mode))mode=\"radial\";const sensitivity=Math.max(0,Math.min(100,Number(config.sensitivity)||55));\nfunction resize(){const box=canvas.getBoundingClientRect();w=Math.max(1,box.width);h=Math.max(1,box.height);dpr=Math.min(devicePixelRatio||1,2,1600/w,1200/h);canvas.width=Math.max(1,Math.round(w*dpr));canvas.height=Math.max(1,Math.round(h*dpr));ctx.setTransform(dpr,0,0,dpr,0,0)}\nfunction clear(alpha=.28){ctx.fillStyle=`rgba(2,2,8,${alpha})`;ctx.fillRect(0,0,w,h)}function bin(i,count=freq.length){return freq[Math.max(0,Math.min(freq.length-1,Math.floor(i/count*freq.length)))]/255}function hue(i,n,offset=0){return `hsl(${(offset+i/n*300)%360} 100% 58%)`}\nfunction radial(now){clear(.38);const cx=w/2,cy=h/2,r=Math.min(w,h)*(.14+pulse*.015),outer=Math.min(w,h)*.43,count=Math.max(72,Math.min(220,Math.floor(w/4)));ctx.lineCap=\"round\";for(let i=0;i<count;i++){const a=i/count*Math.PI*2-Math.PI/2,v=bin(i,count),inner=r,reach=inner+(outer-inner)*(.12+v*.88);ctx.strokeStyle=hue(i,count,now*.012);ctx.globalAlpha=.35+v*.65;ctx.lineWidth=Math.max(1,w/700);ctx.beginPath();ctx.moveTo(cx+Math.cos(a)*inner,cy+Math.sin(a)*inner);ctx.lineTo(cx+Math.cos(a)*reach,cy+Math.sin(a)*reach);ctx.stroke()}ctx.globalAlpha=1}\nfunction equalizer(){clear(.46);const cols=Math.max(16,Math.min(42,Math.floor(w/22))),rows=Math.max(8,Math.min(18,Math.floor(h/20))),gap=Math.max(2,w/250),cw=(w-gap*(cols+1))/cols,ch=Math.min(18,(h*.72-gap*(rows-1))/rows),base=h*.88;for(let x=0;x<cols;x++){const value=bin(x,cols),lit=Math.round(value*rows);for(let y=0;y<rows;y++){const yy=base-y*(ch+gap)-ch,active=y<lit;ctx.fillStyle=active?(y>rows*.82?\"#ed5b16\":y>rows*.62?\"#ffd33d\":`hsl(${125-y*2} 78% 54%)`):\"#07100a\";ctx.globalAlpha=active?1:.55;ctx.fillRect(gap+x*(cw+gap),yy,cw,ch)}}ctx.globalAlpha=1}\nfunction spectrum(now){clear(.34);const cols=Math.max(34,Math.min(86,Math.floor(w/8))),rows=Math.max(18,Math.min(44,Math.floor(h/8))),dx=w/(cols-1),dy=h*.72/(rows-1),bottom=h*.86,r=Math.max(1.3,Math.min(3.4,w/260));for(let x=0;x<cols;x++){const value=bin(x,cols),lit=Math.round(value*rows),glow=Math.max(0,value-.74);for(let y=0;y<rows;y++){ctx.globalAlpha=y<lit?.48+.52*y/rows:.07;ctx.fillStyle=y/rows>.55?\"#ff31c7\":\"#644dff\";ctx.beginPath();ctx.arc(x*dx,bottom-y*dy,r+(y===lit-1?glow*3:0),0,Math.PI*2);ctx.fill()}}ctx.globalAlpha=1;const gx=(now*.03)%w;const grad=ctx.createRadialGradient(gx,bottom-h*.25,0,gx,bottom-h*.25,h*.18);grad.addColorStop(0,\"#ffffff88\");grad.addColorStop(1,\"#ffffff00\");ctx.fillStyle=grad;ctx.fillRect(0,0,w,h)}\nfunction ribbons(now){clear(.2);const lines=Math.max(18,Math.min(48,Math.floor(h/9))),samples=Math.max(70,Math.floor(w/5)),t=now*.00035;ctx.lineWidth=Math.max(1,w/900);for(let j=0;j<lines;j++){const depth=j/(lines-1),base=h*(.12+depth*.78),amp=h*(.035+.13*bin(j,lines))*(.45+depth*.75);ctx.strokeStyle=`hsla(${292+depth*32} 100% ${55+depth*18}% / ${.18+depth*.68})`;ctx.beginPath();for(let i=0;i<samples;i++){const x=i/(samples-1)*w,q=i/(samples-1),v=bin(i,samples)-.5,y=base+Math.sin(q*8+t*5+j*.11)*amp+v*h*.16*(.3+depth);i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke()}}\nfunction waveform(now){clear(.24);const lines=Math.max(12,Math.min(30,Math.floor(h/14))),samples=Math.max(90,Math.floor(w/4)),center=h/2;ctx.lineWidth=Math.max(1,w/1000);for(let j=0;j<lines;j++){const p=j/(lines-1),offset=(p-.5)*h*.5,amp=h*(.09+.08*Math.sin(p*Math.PI));ctx.strokeStyle=hue(j,lines,now*.01);ctx.globalAlpha=.2+.75*(1-Math.abs(p-.5)*1.35);ctx.beginPath();for(let i=0;i<samples;i++){const x=i/(samples-1)*w,v=wave[Math.floor(i/samples*wave.length)]/128-1,y=center+offset+v*amp+Math.sin(i*.045+now*.0015+j*.12)*amp*.32;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke()}ctx.globalAlpha=1}\nfunction consoleView(now){clear(.5);const pad=Math.max(14,w*.04),top=h*.12,mid=h*.48,bottom=h*.82,cols=Math.max(28,Math.min(64,Math.floor(w/10)));ctx.fillStyle=\"#d82bdc22\";for(let x=0;x<cols;x++)for(let y=0;y<12;y++){ctx.beginPath();ctx.arc(pad+x*(w-2*pad)/(cols-1),top+y*(mid-top)/11,1,0,Math.PI*2);ctx.fill()}const gradient=ctx.createLinearGradient(pad,0,w-pad,0);gradient.addColorStop(0,\"#ff45e6\");gradient.addColorStop(.5,\"#a634ff\");gradient.addColorStop(1,\"#ff45e6\");ctx.strokeStyle=gradient;ctx.fillStyle=\"#d420dd33\";ctx.lineWidth=1.5+pulse*2;ctx.beginPath();for(let i=0;i<cols;i++){const x=pad+i/(cols-1)*(w-2*pad),v=wave[Math.floor(i/cols*wave.length)]/128-1,y=(top+mid)/2+v*h*.22;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke();for(let i=0;i<cols;i++){const v=bin(i,cols),bw=(w-2*pad)/cols*.62,bh=v*(bottom-mid);ctx.fillStyle=i%3?\"#ff49eb\":\"#fff\";ctx.fillRect(pad+i*(w-2*pad)/cols,bottom-bh,bw,bh)}for(let i=0;i<8;i++){ctx.globalAlpha=.28+(i%4===Math.floor(now/180)%4?.7:0);ctx.fillStyle=\"#ff38e1\";ctx.beginPath();ctx.arc(w/2+(i-3.5)*16,bottom+22,3,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1}\nfunction measure(now){analyser.getByteFrequencyData(freq);analyser.getByteTimeDomainData(wave);let sum=0,low=0,cut=Math.max(4,Math.floor(freq.length*.12));for(let i=0;i<freq.length;i++){const v=freq[i]/255;sum+=v;if(i<cut)low+=v}level=sum/freq.length;bass=low/cut;baseline=baseline*.94+bass*.06;const gain=1.8-sensitivity/100*1.1;if(bass>Math.max(.12,baseline*1.42)*gain&&now-lastBeat>180){pulse=1;lastBeat=now}else pulse*=.89}\nfunction frame(now){measure(now);if(mode===\"radial\")radial(now);else if(mode===\"equalizer\")equalizer();else if(mode===\"spectrum\")spectrum(now);else if(mode===\"ribbons\")ribbons(now);else if(mode===\"wave\")waveform(now);else consoleView(now);raf=requestAnimationFrame(frame)}\nfunction showError(reason){errorBox.textContent=reason instanceof Error?reason.message:\"Unable to start audio visualization.\";errorBox.classList.remove(\"hidden\")}async function start(){try{if(!ac){ac=new AudioContext();analyser=ac.createAnalyser();analyser.fftSize=512;analyser.smoothingTimeConstant=.7;source=ac.createMediaElementSource(audio);source.connect(analyser);analyser.connect(ac.destination);freq=new Uint8Array(analyser.frequencyBinCount);wave=new Uint8Array(analyser.fftSize)}await ac.resume();if(!raf)frame(performance.now())}catch(reason){showError(reason)}}async function toggle(){try{if(audio.paused){await start();await audio.play()}else audio.pause()}catch(reason){showError(reason)}}function syncPlay(){const paused=audio.paused;playIcon.setAttribute(\"d\",paused?\"M8 5v14l11-7z\":\"M7 5h4v14H7zm6 0h4v14h-4z\");playback.setAttribute(\"aria-label\",paused?\"Play\":\"Pause\")}\nfunction loadAudio(){try{const reference=pageData.audio;if(!reference||typeof reference.artifact_id!==\"string\"||!reference.artifact_id)throw new Error(\"A valid audio artifact is required.\");audio.src=\"/_subfork/artifacts/\"+encodeURIComponent(reference.artifact_id)}catch(reason){showError(reason)}}loadAudio();playback.addEventListener(\"click\",()=>void toggle());audio.addEventListener(\"play\",()=>{syncPlay();void start()});audio.addEventListener(\"pause\",syncPlay);audio.addEventListener(\"ended\",syncPlay);modeButtons.forEach(button=>button.addEventListener(\"click\",()=>{mode=button.dataset.mode;modeButtons.forEach(item=>item.setAttribute(\"aria-pressed\",String(item===button)))}));modeButtons.forEach(button=>button.setAttribute(\"aria-pressed\",String(button.dataset.mode===mode)));new ResizeObserver(resize).observe(document.body);resize();clear(1);syncPlay();\n</script></body></html>"
