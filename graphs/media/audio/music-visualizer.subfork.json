        "node_instance_id": "probe",
        "node_id": "n_media_probe",
        "node_version": "1.0.0",
        "title": "Probe audio on media worker",
        "params": {
          "max_bytes": 50000000,
          "timeout_seconds": 15
        },
        "exposed_inputs": [
          "artifact"
        ],
        "inputs_visibility_configured": true,
        "exposed_outputs": [
          "info"
        ],
        "outputs_visibility_configured": true
      },
